{
  "name": "cvision",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "electron-forge start",
    "electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"cross-env NODE_ENV=development VITE_DEV_SERVER_PORT=3001 vite --port 3001\" \"npm run electron\"",
    "web": "cross-env NODE_ENV=development vite --port 3001",
    "build": "cross-env NODE_ENV=production vite build",
    "lint": "eslint .",
    "preview": "cross-env NODE_ENV=production vite preview",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "electron": "^35.1.3",
    "electron-squirrel-startup": "^1.0.1",
    "glob": "^10.3.10",
    "html2pdf": "^0.0.11",
    "html2pdf.js": "^0.10.3",
    "jotai": "^2.12.2",
    "jspdf": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sass": "^1.86.2",
    "tailwindcss": "^4.1.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "vite": "^6.2.1"
  },
  "description": "Interaktywna aplikacja do tworzenia CV i eksportowania go do PDF. Aplikacja stworzona w React, korzysta z Electron jako framework do budowy aplikacji desktopowych, dzięki czemu można korzystać z aplikacji lokalnie, na komputerze, bez potrzeby uruchamiania w przeglądarce internetowej.",
  "main": "main.js",
  "keywords": [
    "react",
    "electron",
    "cv",
    "cvision",
    "cv-creator",
    "custom cv creator elektron desktop app",
    "cv maker react web app"
  ],
  "author": "Domintes",
  "license": "MIT"
}
